{
  "name": "@tetherto/wdk-asset-registry",
  "version": "1.0.0",
  "description": "The type system and interfaces for standardized asset identification across all WDK modules.",
  "keywords": [
    "wdk",
    "asset",
    "registry"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-asset-registry.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:types": "tsc",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=automerge.test.js",
    "test:automerge": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/automerge.test.js",
    "lint": "standard",
    "lint:fix": "standard --fix"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "30.3.0",
    "standard": "17.1.2",
    "typescript": "6.0.2"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "tests/**/*.js"
    ]
  }
}
